# Brand Commerce Platform — environment template
# Copy values into apps' own .env files. NEVER commit real secrets.

# PostgreSQL (docker compose: docker compose up -d)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/brand_commerce?schema=public

# Redis (used in later phases for queues/caching — P2+)
REDIS_URL=redis://localhost:6379

# API
API_PORT=3001

# Storefront (server-side fetch target)
API_URL=http://localhost:3001
