{
  "name": "brand-commerce",
  "version": "0.1.0",
  "private": true,
  "description": "Brand Commerce Platform — DERMAVIA (Modular Monolith: NestJS API + Next.js Storefront + Prisma/PostgreSQL)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @bc/contracts && npm run build -w @bc/domain && npm run build -w @bc/api && npm run build -w @bc/storefront",
    "test": "npm run test -w @bc/contracts && npm run test -w @bc/domain && npm run test -w @bc/api && npm run test:e2e -w @bc/api",
    "lint": "eslint .",
    "tokens:validate": "python scripts/validate_dtcg_tokens.py",
    "tokens:export": "node scripts/export-dtcg-tokens.mjs",
    "contrast:check": "node scripts/contrast-check.mjs",
    "security:audit": "node scripts/security-audit.mjs",
    "graph:generate": "python scripts/generate_brand_arch_graph.py",
    "prisma:generate": "npm run generate -w @bc/database",
    "prisma:migrate": "npm run migrate -w @bc/database",
    "prisma:seed": "npm run seed -w @bc/database",
    "api:dev": "npm run start:dev -w @bc/api",
    "web:dev": "npm run dev -w @bc/storefront",
    "openapi:export": "node scripts/export-openapi.mjs",
    "openapi:generate": "node scripts/generate-openapi.mjs",
    "db:backup": "node scripts/backup-db.mjs",
    "db:drill": "node scripts/backup-restore-drill.mjs",
    "monitor": "node scripts/health-monitor.mjs",
    "sbom:generate": "node scripts/generate-sbom.mjs",
    "license:audit": "node scripts/license-audit.mjs",
    "load:test": "node scripts/load-test.mjs",
    "a11y:audit": "node scripts/accessibility-audit.mjs",
    "arch:fitness": "node scripts/architecture-fitness.mjs",
    "arch:boundaries": "node scripts/enforce-architecture-fitness.mjs",
    "pact:verify": "node scripts/consumer-contract-test.mjs",
    "figma:verify": "node scripts/verify-code-connect.mjs",
    "polyglot:verify": "node scripts/verify-polyglot-governance.mjs",
    "strangler:simulate": "node scripts/simulate-strangler-extraction.mjs",
    "telemetry:verify": "node scripts/verify-telemetry.mjs",
    "budget:check": "node scripts/performance-budget-check.mjs",
    "workflow:verify": "node scripts/verify-workflow-platform.mjs",
    "integration:real": "node scripts/run-real-service-integration.mjs",
    "content:verify": "node scripts/verify-content-governance.mjs",
    "capacity:benchmark": "node scripts/capacity-benchmark.mjs",
    "claim:enforce": "node scripts/enforce-claim-expiry.mjs",
    "flags:verify": "node scripts/verify-feature-flags.mjs",
    "load:k6": "node scripts/run-k6-load-tests.mjs",
    "asyncapi:validate": "node scripts/validate-asyncapi.mjs",
    "openapi:lint": "node scripts/lint-openapi.mjs",
    "visual:audit": "node scripts/visual-regression-audit.mjs",
    "metrics:agent": "node scripts/agent-quality-metrics.mjs",
    "provenance:verify": "node scripts/verify-provenance.mjs --check",
    "benchmark:monorepo": "node scripts/monorepo-benchmark.mjs",
    "verify": "npm run lint && npm run tokens:validate && npm run contrast:check && npm run a11y:audit && npm run arch:fitness && npm run arch:boundaries && npm run pact:verify && npm run figma:verify && npm run polyglot:verify && npm run strangler:simulate && npm run telemetry:verify && npm run budget:check && npm run workflow:verify && npm run content:verify && npm run capacity:benchmark && npm run claim:enforce && npm run flags:verify && npm run security:audit && npm run license:audit && npm run asyncapi:validate && npm run openapi:lint && npm run visual:audit && npm run metrics:agent && npm run build && npm run test && npm run integration:real && npm run load:k6 && npm run provenance:verify"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "typescript-eslint": "^8.18.0"
  }
}
