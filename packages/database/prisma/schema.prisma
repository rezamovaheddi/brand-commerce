// Brand Commerce Platform — PostgreSQL data model (initial vertical slice)
// Domain ownership: packages/database owns the schema; other modules must not
// alter domain data directly (see docs/adr/).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  nameFa    String
  nameEn    String
  isActive  Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id            String         @id @default(cuid())
  slug          String         @unique
  nameFa        String
  nameEn        String
  descriptionFa String?
  descriptionEn String?
  status        ProductStatus  @default(DRAFT)
  // true ⇒ seed/sample data; production must never display these as real catalog
  isSample      Boolean        @default(true)
  category      Category?      @relation(fields: [categoryId], references: [id])
  categoryId    String?
  variants      ProductVariant[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([categoryId])
  @@index([status])
}

model ProductVariant {
  id         String        @id @default(cuid())
  sku        String        @unique
  product    Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  titleFa    String
  titleEn    String
  // Minor units (IRR rial). Real pricing/taxation is a pending business decision.
  priceMinor Int
  currency   String        @default("IRR")
  isDefault  Boolean       @default(false)
  status     ProductStatus @default(DRAFT)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  cartItems  CartItem[]
  inventory  InventoryItem?

  @@index([productId])
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

// Guest cart (P2 slice). Server-authoritative: prices/quantities are never
// trusted from the client; totals are computed by packages/domain rules.
model Cart {
  id        String     @id @default(cuid())
  status    CartStatus @default(ACTIVE)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String         @id @default(cuid())
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId    String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  variantId String
  // 1..MAX_QUANTITY enforced by domain rules AND validated at the boundary
  quantity  Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([cartId, variantId])
  @@index([cartId])
}

enum OrderStatus {
  // Widenend in P3 with the sandbox payment slice; the pure state machine in
  // packages/domain remains the single authority on legal transitions.
  DRAFT
  CANCELLED
  AWAITING_PAYMENT
  PAID
  SHIPPED
  DELIVERED
  REFUNDED
}

// Guest order draft (P2). Lines are immutable SNAPSHOTs of variant data and
// server-resolved prices at checkout time — never joined live from the catalog.
model Order {
  id            String      @id @default(cuid())
  status        OrderStatus @default(DRAFT)
  cartId        String?     @unique
  currency      String      @default("IRR")
  itemCount     Int
  subtotalMinor Int
  // Shipping address snapshot (guest checkout) — Iranian market fields pending
  // final market decision (D-01): kept plain text, normalized at the boundary.
  fullName      String
  phone         String
  province      String
  city          String
  postalCode    String
  addressLine   String
  lines         OrderLine[]
  payments      Payment[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model OrderLine {
  id             String @id @default(cuid())
  order          Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId        String
  variantId      String
  sku            String
  productNameFa  String
  productNameEn  String
  titleFa        String
  titleEn        String
  quantity       Int
  unitPriceMinor Int
  currency       String
  lineTotalMinor Int

  @@index([orderId])
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

// Sandbox payment records (P3 slice). provider='sandbox' + isSandbox=true are
// hard markers: these are NEVER real money and the UI must label them SANDBOX.
// The real PSP adapter replaces this module without changing the state machine.
model Payment {
  id             String        @id @default(cuid())
  order          Order         @relation(fields: [orderId], references: [id])
  orderId        String
  amountMinor    Int
  currency       String        @default("IRR")
  status         PaymentStatus @default(PENDING)
  provider       String        @default("sandbox")
  isSandbox      Boolean       @default(true)
  // optional client-supplied Idempotency-Key (unique per intent)
  idempotencyKey String?       @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([orderId])
}

// Inventory-lite (P5 gate). One row per variant: onHand = physically in stock,
// reserved = held by unpaid orders. availableToSell = onHand - reserved.
// Every mutation writes an append-only InventoryLedger row (audit trail).
model InventoryItem {
  id        String @id @default(cuid())
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  variantId String @unique
  onHand    Int    @default(0)
  reserved  Int    @default(0)

  @@index([variantId])
}

enum InventoryReason {
  INITIAL
  RESERVE
  RELEASE
  SALE
  RESTOCK
  ADJUSTMENT
}

model InventoryLedger {
  id         String          @id @default(cuid())
  variantId  String
  // Positive delta = stock in / reservation released back; negative = out.
  deltaOnHand   Int
  deltaReserved Int
  reason        InventoryReason
  // Pointer to the business event (order id, payment id, manual adjustment id)
  refType       String
  refId         String
  createdAt     DateTime        @default(now())

  @@index([variantId])
  @@index([refType, refId])
}

// ---- B2B onboarding scaffold (P4 slice — decision-independent parts) -------
// Per bounded-context rules: Organization owns orgs/branches/memberships;
// Identity owns user credentials. Cross-org scoping is enforced app-side
// (N16); membership carries NO user credentials in this slice.

enum OrgStatus {
  ACTIVE
  SUSPENDED
}

enum OrgMemberRole {
  OWNER
  BUYER
  ACCOUNTANT
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  // Sample-marked until business verification (B4) approves real distributors
  isSample  Boolean  @default(true)
  status    OrgStatus @default(ACTIVE)
  members   OrganizationMembership[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrganizationMembership {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  contactName    String
  contactPhone   String
  email          String?
  role           OrgMemberRole @default(OWNER)
  // N16 bootstrap access control: operator-issued high-entropy key; only the
  // SHA-256 hash is stored (plaintext returned once at issuance). Replaced by
  // real Identity credentials in P7.
  keyHash        String?      @unique
  keyLast4       String?
  keyRevokedAt   DateTime?
  lastUsedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@unique([organizationId, contactPhone, role])
  @@unique([organizationId, email])
  @@index([organizationId])
}

enum B2BApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  NEEDS_INFO
}

// Distributor/agency application (B3/B4-lite): submit → admin review →
// approve creates the Organization + OWNER membership; reject records the note.
model B2BApplication {
  id           String              @id @default(cuid())
  contactName  String
  contactPhone String
  orgName      String
  economicCode String?
  licenseRef   String?
  status       B2BApplicationStatus @default(SUBMITTED)
  reviewNote   String?
  reviewedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([status])
}

// ---- RFQ / Quote (P4 slice, N11: immutable revisions) ----------------------
// Rfq: public request for quote (contact-based until Identity lands; orgId
// set when the submitter belongs to an approved organization).
// Quote revisions are APPEND-ONLY snapshots — never updated in place.
// Prices inside revisions are SAMPLE-marked (D-11 pending): isSample=true.

enum RfqStatus {
  SUBMITTED
  PRICED
  QUOTED
  ACCEPTED
  REJECTED
  CLOSED
}

model Rfq {
  id           String    @id @default(cuid())
  status       RfqStatus @default(SUBMITTED)
  orgId        String?
  contactName  String
  contactPhone String
  note         String?
  items        RfqItem[]
  quote        Quote?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([orgId])
}

model RfqItem {
  id         String   @id @default(cuid())
  rfq        Rfq      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  rfqId      String
  variantId  String?
  productName String
  quantity   Int
  note       String?

  @@index([rfqId])
}

enum QuoteStatus {
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model Quote {
  id        String      @id @default(cuid())
  rfq       Rfq         @relation(fields: [rfqId], references: [id])
  rfqId     String      @unique
  status    QuoteStatus @default(SENT)
  currency  String      @default("IRR")
  validUntil DateTime
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  revisions QuoteRevision[]

  @@index([rfqId])
}

model QuoteRevision {
  id           String @id @default(cuid())
  quote        Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId      String
  revisionNo   Int
  // Immutable line snapshot: [{ variantId?, productName, quantity, unitPriceMinor, lineTotalMinor }]
  linesJson    Json
  subtotalMinor Int
  currency     String @default("IRR")
  leadTimeDays Int?
  paymentTerms String?
  // SAMPLE pricing marker: real contract pricing awaits D-11
  isSample     Boolean @default(true)
  note         String?
  createdAt    DateTime @default(now())

  @@unique([quoteId, revisionNo])
  @@index([quoteId])
}
