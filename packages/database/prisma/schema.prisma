// Brand Commerce Platform — PostgreSQL data model (initial vertical slice)
// Domain ownership: packages/database owns the schema; other modules must not
// alter domain data directly (see docs/adr/).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  nameFa    String
  nameEn    String
  isActive  Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id            String         @id @default(cuid())
  slug          String         @unique
  nameFa        String
  nameEn        String
  descriptionFa String?
  descriptionEn String?
  status        ProductStatus  @default(DRAFT)
  // true ⇒ seed/sample data; production must never display these as real catalog
  isSample      Boolean        @default(true)
  category      Category?      @relation(fields: [categoryId], references: [id])
  categoryId    String?
  variants      ProductVariant[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([categoryId])
  @@index([status])
}

model ProductVariant {
  id         String        @id @default(cuid())
  sku        String        @unique
  product    Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  titleFa    String
  titleEn    String
  // Minor units (IRR rial). Real pricing/taxation is a pending business decision.
  priceMinor Int
  currency   String        @default("IRR")
  isDefault  Boolean       @default(false)
  status     ProductStatus @default(DRAFT)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  cartItems  CartItem[]

  @@index([productId])
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

// Guest cart (P2 slice). Server-authoritative: prices/quantities are never
// trusted from the client; totals are computed by packages/domain rules.
model Cart {
  id        String     @id @default(cuid())
  status    CartStatus @default(ACTIVE)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String         @id @default(cuid())
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId    String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  variantId String
  // 1..MAX_QUANTITY enforced by domain rules AND validated at the boundary
  quantity  Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([cartId, variantId])
  @@index([cartId])
}

enum OrderStatus {
  // P2: draft orders only. AWAITING_PAYMENT/PAID/SHIPPED/... arrive with the
  // P3 payment adapter — the state machine lives in packages/domain.
  DRAFT
  CANCELLED
}

// Guest order draft (P2). Lines are immutable SNAPSHOTs of variant data and
// server-resolved prices at checkout time — never joined live from the catalog.
model Order {
  id            String      @id @default(cuid())
  status        OrderStatus @default(DRAFT)
  cartId        String?     @unique
  currency      String      @default("IRR")
  itemCount     Int
  subtotalMinor Int
  // Shipping address snapshot (guest checkout) — Iranian market fields pending
  // final market decision (D-01): kept plain text, normalized at the boundary.
  fullName      String
  phone         String
  province      String
  city          String
  postalCode    String
  addressLine   String
  lines         OrderLine[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model OrderLine {
  id             String @id @default(cuid())
  order          Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId        String
  variantId      String
  sku            String
  productNameFa  String
  productNameEn  String
  titleFa        String
  titleEn        String
  quantity       Int
  unitPriceMinor Int
  currency       String
  lineTotalMinor Int

  @@index([orderId])
}
