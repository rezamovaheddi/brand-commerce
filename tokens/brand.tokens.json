        "$value": {
          "value": 120,
          "unit": "ms"
        }
      },
      "normal": {
        "$value": {
          "value": 180,
          "unit": "ms"
        }
      },
      "slow": {
        "$value": {
          "value": 280,
          "unit": "ms"
        }
      }
